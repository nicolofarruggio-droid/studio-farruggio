# BigBrotherStudio — variabili d'ambiente. Copia in .env.local e completa. Nessun valore reale nel repository.

# Indirizzo pubblico del sito (link nelle email, ritorno da Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (regione UE, Francoforte). Da Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server: amministrazione di utenti (inviti) e file. Mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=
# Connessione Postgres del pooler (modalità transaction, porta 6543), utente postgres.
DATABASE_URL=
# Facoltativo: connessione diretta per le migrazioni (porta 5432)
DATABASE_URL_MIGRAZIONI=
DATABASE_POOL_MAX=5

# Documenti dei compiti: "supabase" (produzione) oppure "locale" (sviluppo senza Supabase Storage)
STORAGE_DRIVER=supabase
STORAGE_BUCKET=documenti
DOCUMENTI_MAX_MB=25
# Solo con STORAGE_DRIVER=locale: segreto per firmare i link temporanei
FILE_LOCALI_SEGRETO=

# Email in uscita (inviti, notifiche) — SMTP con dominio proprio, per esempio Brevo.
# Configurare lo stesso SMTP anche in Supabase Auth per conferme e recupero password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_MITTENTE="BigBrotherStudio <noreply@tuodominio.it>"

# AI: API Anthropic diretta, account studiofarruggio@gmail.com (sezione 17.2). Solo server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Solo sviluppo e test: risposte AI simulate, nessuna chiamata esterna. Mai in produzione.
AI_SIMULATA=

# Google OAuth per il collegamento Gmail in sola lettura (gmail.readonly). Stesso progetto Google Cloud
# del login "Accedi con Google" (che si configura in Supabase Auth → Providers → Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chiave AES-256 (32 byte in base64) per cifrare i token delle caselle: openssl rand -base64 32
EMAIL_TOKEN_CHIAVE=
# Controllo delle caselle (sezione 16.3): ogni N minuti, nelle ore e nei giorni indicati (ora italiana)
EMAIL_CONTROLLO_MINUTI=10
EMAIL_CONTROLLO_ORA_INIZIO=8
EMAIL_CONTROLLO_ORA_FINE=21
# giorni: 1 = lunedì … 7 = domenica
EMAIL_CONTROLLO_GIORNI=1,2,3,4,5,6

# Segreto dei processi pianificati (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
